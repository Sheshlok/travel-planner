# Copy this file to .env and fill in your keys. Never commit .env.
OPENAI_API_KEY=
TAVILY_API_KEY=
SERPAPI_API_KEY=

# Optional overrides
# TRAVEL_PLANNER_MODEL=gpt-5.2
# TRAVEL_PLANNER_TEMPERATURE=0.2
# For gpt-5 (no custom temperature), use:
# TRAVEL_PLANNER_MODEL=gpt-5
# TRAVEL_PLANNER_TEMPERATURE=
# Per-request model timeout in seconds, and retries
# TRAVEL_PLANNER_LLM_TIMEOUT=180
# TRAVEL_PLANNER_LLM_MAX_RETRIES=2
# Reasoning effort for gpt-5 models (minimal/low/medium/high); faster when lower
# TRAVEL_PLANNER_REASONING_EFFORT=low

# Optional: LangSmith tracing
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=

# Research limits (lower = faster answers, less research)
# TRAVEL_PLANNER_PLANNER_MAX_ROUNDS=2
# TRAVEL_PLANNER_SEARCH_MAX_ROUNDS=3
# TRAVEL_PLANNER_ITINERARY_MAX_STEPS=30

# Web UI: database file for conversations/memory, and max questions running at once
# TRAVEL_PLANNER_DB=.data/travel_planner.sqlite
# TRAVEL_PLANNER_MAX_JOBS=3

# Optional: password for the Streamlit web UI (leave unset for no password)
# APP_PASSWORD=
